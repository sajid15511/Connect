# MongoDB connection string (Atlas recommended for production)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/connect-app?retryWrites=true&w=majority

# NextAuth
AUTH_SECRET=generate-a-random-secret-here
AUTH_URL=https://your-app.vercel.app

# Socket.IO server URL (deployed separately on Railway/Render)
NEXT_PUBLIC_SOCKET_URL=https://your-socket-server.railway.app
SOCKET_PORT=3001
